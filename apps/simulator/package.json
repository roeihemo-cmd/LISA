{
  "name": "lisa-simulator",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "LISA v2 — web-based LiDAR + ADAS engineering simulator (Truth/Perception pipeline)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "publish:next": "npm run build && node scripts/publish.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
